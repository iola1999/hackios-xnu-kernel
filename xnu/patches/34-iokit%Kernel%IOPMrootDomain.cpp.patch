diff --git a/iokit/Kernel/IOPMrootDomain.cpp b/iokit/Kernel/IOPMrootDomain.cpp
index 4a06407aea5f..69a4bcf1839d 100644
--- a/iokit/Kernel/IOPMrootDomain.cpp
+++ b/iokit/Kernel/IOPMrootDomain.cpp
@@ -555,7 +555,16 @@ static uint32_t         gDarkWakeFlags = kDarkWakeFlagPromotionEarly;
 #endif /* !defined(XNU_TARGET_OS_OSX) */
 
 static uint32_t         gNoIdleFlag = 0;
-static uint32_t         gSleepDisabledFlag = 0;
+/*
+ * redwood: the system does not sleep. There is nothing here to sleep into and nothing that would
+ * wake it: with the screen locked, powerd asks for system sleep within seconds, and that request
+ * ended in IOCPUSleepKernel() -- with one processor it came straight back out, again and again
+ * (every time a round of sleep and wake notifications to all the system); with more than one it
+ * stopped there for good, waiting for a processor to go that never goes. Refused instead, the
+ * system stays awake with its display off, and the side button or a tap wakes the screen.
+ * Boot-arg syssleep=1 gives the old behaviour back.
+ */
+static uint32_t         gSleepDisabledFlag = 1;
 static uint32_t         gSwdPanic = 1;
 static uint32_t         gSwdSleepTimeout = 0;
 static uint32_t         gSwdWakeTimeout = 0;
@@ -1587,6 +1596,13 @@ IOPMrootDomain::start( IOService * nub )
 #endif /* DEVELOPMENT || DEBUG */
 
 	PE_parse_boot_argn("noidle", &gNoIdleFlag, sizeof(gNoIdleFlag));
+	{
+		uint32_t syssleep = 0;
+
+		if (PE_parse_boot_argn("syssleep", &syssleep, sizeof(syssleep)) && syssleep) {
+			gSleepDisabledFlag = 0;
+		}
+	}
 	PE_parse_boot_argn("swd_sleeptimeout", &gSwdSleepTimeout, sizeof(gSwdSleepTimeout));
 	PE_parse_boot_argn("swd_waketimeout", &gSwdWakeTimeout, sizeof(gSwdWakeTimeout));
 	PE_parse_boot_argn("swd_timeout", &gSwdSleepWakeTimeout, sizeof(gSwdSleepWakeTimeout));
