 extern bool system_is_SMT;
 
+/*
+ * The "secondaries" are not the second threads of hyperthreaded cores but slower cores of their
+ * own, each paired with a faster one (ml_pair_slow_processors() in osfmk/arm64/machine_routines.c):
+ * the scheduler still prefers the primaries, but what runs on one core does not slow the other,
+ * so a secondary is not kept idle for its primary's sake, and when a primary goes idle a thread
+ * running on a secondary is moved to it.
+ */
+extern bool sched_slow_secondaries;
