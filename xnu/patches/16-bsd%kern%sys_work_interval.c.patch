diff --git a/bsd/kern/sys_work_interval.c b/bsd/kern/sys_work_interval.c
index b544bf307dfe..85e34caf9f62 100644
--- a/bsd/kern/sys_work_interval.c
+++ b/bsd/kern/sys_work_interval.c
@@ -265,6 +265,22 @@ work_interval_ctl(__unused proc_t p, struct work_interval_ctl_args *uap,
 
 		break;
 
+	case 6:
+	case 7:
+	case 8:
+		/*
+		 * (redwood) Not in the open source: what os_workgroup_interval_start(), _update() and
+		 * _finish() of iOS send, for the performance controller, which is not here either.
+		 * CoreAudio does it in every I/O cycle and logs an error each time it is refused: fifty
+		 * lines a second from the audio server's real-time thread. For its threads, and only
+		 * for them, there is nothing to do and nothing wrong. (The window server asks for its
+		 * frames too, and is used to the refusal.)
+		 */
+		if (kern_work_interval_type_of_thread(current_thread()) == WORK_INTERVAL_TYPE_COREAUDIO) {
+			return 0;
+		}
+		return ENOTSUP;
+
 	default:
 		return ENOTSUP;
 	}
