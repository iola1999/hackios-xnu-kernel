diff --git a/osfmk/arm64/locore.s b/osfmk/arm64/locore.s
index 3f42af80fee0..3d6d1bf2435c 100644
--- a/osfmk/arm64/locore.s
+++ b/osfmk/arm64/locore.s
@@ -980,6 +980,57 @@ el1_sp1_serror_vector_long:
 .endmacro
 
 el0_synchronous_vector_64_long:
+#if defined(ANNIBALE_ARM64E_USERLAND) && !__ARM_KERNEL_PROTECT__ && !CONFIG_SPTM && !HAS_CONTINUOUS_HWCLOCK
+	stp		x1, x2, [sp, #-32]!
+	stp		x3, x4, [sp, #16]
+	mrs		x1, ESR_EL1
+	movz	w2, #0x5600, lsl #16
+	movk	w2, #0x0080
+	cmp		x1, x2
+	b.ne	Lel0_sync_slowpath
+	cmn		w16, #3
+	b.eq	Lel0_timebase_fast_ok
+	cmn		w16, #4
+	b.ne	Lel0_sync_slowpath
+Lel0_timebase_fast_ok:
+	mrs		x1, TPIDR_EL1
+	ldr		x1, [x1, ACT_CPUDATAP]
+	ldr		w2, [x1, CPU_PENDING_AST]
+	cbnz	w2, Lel0_sync_slowpath
+1:
+	adrp	x3, EXT(mach_absolutetime_asleep)@page
+	add		x3, x3, EXT(mach_absolutetime_asleep)@pageoff
+	ldr		x4, [x3]
+	ldr		x2, [x1, CPU_BASE_TIMEBASE]
+	isb
+	mrs		x0, CNTVCT_EL0
+	ldr		x3, [x1, CPU_BASE_TIMEBASE]
+	cmp		x2, x3
+	b.ne	1b
+	adrp	x3, EXT(annibale_timebase_scale_125)@page
+	add		x3, x3, EXT(annibale_timebase_scale_125)@pageoff
+	ldr		w3, [x3]
+	cbz		w3, 2f
+	add		x0, x0, x0, lsr #2
+2:
+	add		x0, x0, x2
+	cmn		w16, #4
+	b.ne	3f
+	dmb		ish
+	adrp	x3, EXT(mach_absolutetime_asleep)@page
+	add		x3, x3, EXT(mach_absolutetime_asleep)@pageoff
+	ldr		x3, [x3]
+	cmp		x4, x3
+	b.ne	1b
+	add		x0, x0, x4
+3:
+	ldp		x3, x4, [sp, #16]
+	ldp		x1, x2, [sp], #32
+	ERET_NO_STRAIGHT_LINE_SPECULATION
+Lel0_sync_slowpath:
+	ldp		x3, x4, [sp, #16]
+	ldp		x1, x2, [sp], #32
+#endif
 	EL0_64_VECTOR	sync
 	EL0_64_VECTOR_SWITCH_TO_KERN_STACK
 	adrp	x1, EXT(fleh_synchronous)@page			// Load address for fleh
