diff --git a/osfmk/arm/cpuid.c b/osfmk/arm/cpuid.c
index 2b838e729142..202048aae44a 100644
--- a/osfmk/arm/cpuid.c
+++ b/osfmk/arm/cpuid.c
@@ -91,6 +91,12 @@ do_cpuid(void)
 
 #if defined(HAS_APPLE_PAC)
 	cpuid_cpu_info.arm_info.arm_arch = CPU_ARCH_ARMv8E;
+#elif defined(REDWOOD_ARM64E_USERLAND)
+	/* (see pexpert/arm64/BCM2837.h) boot-arg arm64e=0: arm64, for a system without arm64e programs */
+	uint32_t arm64e = 1;
+
+	PE_parse_boot_argn("arm64e", &arm64e, sizeof(arm64e));
+	cpuid_cpu_info.arm_info.arm_arch = arm64e ? CPU_ARCH_ARMv8E : CPU_ARCH_ARMv8;
 #else /* defined(HAS_APPLE_PAC) */
 	cpuid_cpu_info.arm_info.arm_arch = CPU_ARCH_ARMv8;
 #endif /* defined(HAS_APPLE_PAC) */
