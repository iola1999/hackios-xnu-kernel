 #include <libkern/OSKextLibPrivate.h>
 #include <vm/vm_kern.h>
 #include <kern/kern_cdata.h>
@@ -199,6 +202,30 @@ _Atomic unsigned int  mp_kdp_trap = 0; /* CPUs signalled by the debug CPU will s
 _Atomic unsigned int  debug_cpus_spinning = 0; /* Number of signalled CPUs still spinning on mp_kdp_trap (in DebuggerXCall). */
 unsigned int          DebugContextCount = 0;
 bool                  trap_is_stackshot = false; /* Whether the trap is for a stackshot */
+#if defined(GENERIC_PSCI_SMP)
+static _Atomic uint32_t psci_panic_loser_mask = 0;
+
+void __attribute__((noinline, noreturn))
+psci_panic_stop_loser(unsigned long caller_pc, unsigned long caller_fp)
+{
+	cpu_data_t *cdp = getCpuDatap();
+	int cpu = cpu_number();
+
+	if (cdp != NULL) {
+		cdp->ipi_pc = (uint64_t)caller_pc;
+		cdp->ipi_lr = (uint64_t)caller_pc;
+		cdp->ipi_fp = (uint64_t)caller_fp;
+		cdp->halt_status = CPU_HALTED_WITH_STATE;
+	}
+	if (cpu >= 0 && cpu < 32) {
+		os_atomic_or(&psci_panic_loser_mask, 1u << cpu, release);
+	}
+	for (;;) {
+		psci_smp_stop_here();
+		__builtin_arm_wfe();
+	}
+}
+#endif
 
 #if defined(__arm64__)
 uint8_t PE_smc_stashed_x86_system_state = 0xFF;
@@ -1154,6 +1181,11 @@ DebuggerXCallEnter(
 		}
 
 		max_mabs_time = os_atomic_load(&debug_ack_timeout, relaxed);
+#if defined(GENERIC_PSCI_SMP)
+		if (max_mabs_time > 0 && max_mabs_time < 2400000ull) {
+			max_mabs_time = 2400000ull;
+		}
+#endif
 
 		/*
 		 * If the debug_ack_timeout is zero, we will wait for one second, which is more than
@@ -1197,6 +1229,11 @@ DebuggerXCallEnter(
 			if (!(target_cpu_datap->cpu_signal & SIGPdebug)) {
 				continue;
 			}
+#if defined(GENERIC_PSCI_SMP)
+			if (cpu < 32 && (os_atomic_load(&psci_panic_loser_mask, acquire) & (1u << cpu)) != 0) {
+				continue;
+			}
+#endif
 			if (processor_array[cpu]->state <= PROCESSOR_PENDING_OFFLINE) {
 				int dbg_sync_count;
 
@@ -1252,6 +1289,35 @@ DebuggerXCallEnter(
 		if (immediate_halt) {
 			__builtin_arm_dmb(DMB_ISH);
 		}
+#if defined(GENERIC_PSCI_SMP)
+		for (cpu = 0; cpu <= max_cpu; cpu++) {
+			target_cpu_datap = (cpu_data_t *)CpuDataEntries[cpu].cpu_data_vaddr;
+
+			if ((target_cpu_datap == NULL) || (target_cpu_datap == cpu_data_ptr)) {
+				continue;
+			}
+			if (target_cpu_datap->coresight_base[CORESIGHT_ED] == 0) {
+				if (!(target_cpu_datap->cpu_signal & SIGPdebug) ||
+				    (cpu < 32 && (os_atomic_load(&psci_panic_loser_mask, acquire) & (1u << cpu)) != 0) ||
+				    processor_array[cpu]->state <= PROCESSOR_PENDING_OFFLINE) {
+					target_cpu_datap->halt_status = CPU_HALTED_WITH_STATE;
+				} else {
+					paniclog_append_noflush("cpu %d did not respond to SIGPdebug IPI (interrupts masked)\n", cpu);
+					debug_ack_timeout_count++;
+				}
+				continue;
+			}
+			paniclog_append_noflush("Attempting to forcibly halt cpu %d\n", cpu);
+			dbgwrap_status_t halt_status = ml_dbgwrap_halt_cpu_with_state(cpu,
+			    NSEC_PER_SEC, &target_cpu_datap->halt_state);
+			if ((halt_status < 0) || (halt_status == DBGWRAP_WARN_CPU_OFFLINE)) {
+				paniclog_append_noflush("Unable to obtain state for cpu %d with status %d: %s\n", cpu, halt_status, ml_dbgwrap_strerror(halt_status));
+				debug_ack_timeout_count++;
+			} else {
+				target_cpu_datap->halt_status = CPU_HALTED_WITH_STATE;
+			}
+		}
+#else
 		for (cpu = 0; cpu <= max_cpu; cpu++) {
 			target_cpu_datap = (cpu_data_t *)CpuDataEntries[cpu].cpu_data_vaddr;
 
@@ -1285,6 +1351,7 @@ DebuggerXCallEnter(
 				target_cpu_datap->halt_status = CPU_HALTED_WITH_STATE;
 			}
 		}
+#endif
 		if (immediate_halt) {
 			paniclog_append_noflush("Immediate halt requested on all cores\n");
 		} else {
@@ -1368,6 +1435,13 @@ wait_while_mp_kdp_trap(bool check_SIGPdebug)
 			found_SIGPdebug = true;
 			break;
 		}
+#if defined(GENERIC_PSCI_SMP)
+		/*
+		 * The panic this processor is waiting out ends in a return to the boot loader:
+		 * its interrupts are off here, so this is where it is told (psci_smp.c).
+		 */
+		psci_smp_stop_here();
+#endif
 		__builtin_arm_wfe();
 	}
 	os_atomic_clear_exclusive();
