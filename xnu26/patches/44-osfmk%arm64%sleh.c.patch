 static void
+copyio_fault_trace(
+	const char                     *kind,
+	arm_saved_state_t              *state,
+	uint64_t                        esr,
+	vm_offset_t                     fault_addr,
+	fault_status_t                  fault_code,
+	vm_prot_t                       fault_type,
+	int                             result,
+	thread_t                        thread,
+	struct copyio_recovery_entry   *recover)
+{
+	static uint32_t loc_said, other_said;
+	task_t task = (thread != THREAD_NULL) ? current_task() : TASK_NULL;
+	void *bsd = (task != TASK_NULL) ? get_bsdtask_info(task) : NULL;
+	const char *pname = bsd ? proc_name_address(bsd) : "?";
+	bool is_loc = (bsd != NULL && strncmp(pname, "locationd", 9) == 0);
+	uint32_t *counter = is_loc ? &loc_said : &other_said;
+
+	if (os_atomic_load(counter, relaxed) >= 8 ||
+	    os_atomic_inc(counter, relaxed) > 8) {
+		return;
+	}
+
+	int pid = bsd ? proc_selfpid() : 0;
+	int irqs_on = SPSR_INTERRUPTS_ENABLED(get_saved_state_cpsr(state)) ? 1 : 0;
+	uint64_t pc = get_saved_state_pc(state);
+	uint64_t lr = is_saved_state64(state) ? saved_state64(state)->lr : 0;
+	uint64_t rec_start = (uint64_t)((uintptr_t)copyio_recover_table + (uintptr_t)recover->cre_start);
+	uint64_t rec_target = (uint64_t)((uintptr_t)copyio_recover_table + (uintptr_t)recover->cre_recovery);
+	int trec = (thread != THREAD_NULL) ? (int)thread->recover : -1;
+	char msg[256];
+
+	snprintf(msg, sizeof(msg),
+	    "copyio_abort(%s): %s[%d] far=0x%llx pc=0x%llx lr=0x%llx res=%d fc=0x%x ft=0x%x esr=0x%llx irqs_on=%d rec=0x%llx->0x%llx trec=%d",
+	    kind, pname, pid, (unsigned long long)fault_addr,
+	    (unsigned long long)pc, (unsigned long long)lr,
+	    result, (unsigned)fault_code, (unsigned)fault_type,
+	    (unsigned long long)esr, irqs_on,
+	    (unsigned long long)rec_start, (unsigned long long)rec_target, trec);
+	if (irqs_on) {
+		printf("%s\n", msg);
+	} else {
+		kprintf("%s\n", msg);
+	}
+}
