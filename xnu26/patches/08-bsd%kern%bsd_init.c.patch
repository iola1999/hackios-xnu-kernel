diff --git a/bsd/kern/bsd_init.c b/bsd/kern/bsd_init.c
index ffe7ce0..1759d44 100644
--- a/bsd/kern/bsd_init.c
+++ b/bsd/kern/bsd_init.c
@@ -146,6 +146,13 @@
 #include <net/if_ether.h>               /* for ether_family_init() */
 #include <net/if_gif.h>                 /* for gif_init() */
 #include <miscfs/devfs/devfsdefs.h>     /* for devfs_kernel_mount() */
+#include <sys/annibale_input.h>
+#include <sys/annibale_audio.h>
+#include <sys/annibale_virtio_blk.h>
+#include <sys/annibale_sparse.h>
+#if APFS
+#include <sys/annibale_apfs_check.h>
+#endif
 #include <vm/vm_kern.h>                 /* for kmem_suballoc() */
 #include <sys/proc_uuid_policy.h>       /* proc_uuid_policy_init() */
 #include <netinet/flow_divert.h>        /* flow_divert_init() */
@@ -457,7 +464,12 @@ bsd_rooted_ramdisk(void)
 		panic("failed to allocate devpath string!");
 	}
 
-	if (PE_parse_boot_argn("rd", dev_path, MAXPATHLEN)) {
+	/*
+	 * (rootdev= as well: iOS 26's launchd takes "rd=md0" in the boot-args for a restore
+	 * environment, so a RAM disk root that is to boot normally is named with rootdev=.)
+	 */
+	if (PE_parse_boot_argn("rd", dev_path, MAXPATHLEN) ||
+	    PE_parse_boot_argn("rootdev", dev_path, MAXPATHLEN)) {
 		if (strncmp(dev_path, RAMDEV, strlen(RAMDEV)) == 0) {
 			is_ramdisk = true;
 		}
@@ -498,7 +510,7 @@ bsd_init(void)
 	check_for_failure_injection(XNU_STAGE_BSD_INIT_START);
 #endif
 
-#define DEBUG_BSDINIT 0
+#define DEBUG_BSDINIT 1 /* bring-up: trace bsd_init steps (only visible with -enable_kprintf_spam) */
 
 #if DEBUG_BSDINIT
 #define bsd_init_kprintf(x, ...) kprintf("bsd_init: " x, ## __VA_ARGS__)
@@ -698,6 +710,24 @@ bsd_init(void)
 	IOKitInitializeTime();
 
 	/* Initialize the file systems. */
+	extern int desiredvnodes;
+	/*
+	 * Capacity tier upgrade for Annibale (SM8750 / 16 GiB RAM).
+	 * Upgrade legacy BCM2837 limit (CONFIG_VNODES=1024) to large tier:
+	 * Sized based on (sane_size / 65536) + 1024, clamped to [65536, 263168].
+	 * This ensures that vntblinit() and nchinit() allocate full-capacity
+	 * vnode tables and enlarged namecache hash buckets for 16 GiB RAM.
+	 */
+	if (desiredvnodes < 65536) {
+		int target_vnodes = (int)(sane_size / 65536) + 1024;
+		if (target_vnodes < 65536) {
+			target_vnodes = 65536;
+		} else if (target_vnodes > 263168) {
+			target_vnodes = 263168;
+		}
+		desiredvnodes = target_vnodes;
+	}
+
 	bsd_init_kprintf("calling vfsinit\n");
 	vfsinit();
 
@@ -1002,6 +1032,14 @@ bsd_init(void)
 
 		bsd_init_kprintf("calling devfs_kernel_mount\n");
 		devfs_kernel_mount(mounthere);
+		annibale_input_init();           /* /dev/annibale-touch */
+		annibale_audio_init();           /* /dev/annibale-audio */
+		annibale_virtio_blk_init();      /* /dev/rvblk0, a disk image of the host (QEMU) */
+		annibale_sparse_init();          /* /dev/rsp0, part of an image too big to hold */
+#if APFS
+		/* mounts and walks /dev/rvblk0 once userland has /private/var up */
+		annibale_apfs_check_init();
+#endif
 	}
 #endif /* DEVFS */
 
