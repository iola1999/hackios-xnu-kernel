# A whitelist: the working tree also holds gigabytes of downloads, build output, logs, third-party
# clones, files of iOS and hackios-xnu-userland links, none of which belongs
# in this repository. Nothing is tracked unless it is named here.
/*
!/.gitignore
!/README.md
!/LICENSE
!/NOTICES.md
!/common/
!/docs/
!/xl
!/mkxnuimg.py
!/xnuloader/
!/qemu/
!/tools/
!/xnu/
!/xnu26/
!/xnu-deps/
!/uefi/
!/prebuilt/
!/wifi/

__pycache__/
.DS_Store
*~
*.orig
*.rej

# hackios-xnu-userland's files
/docs/air.md
/docs/air-report.md
/tools/apfs
/tools/air
/tools/mesa
/tools/metal
/tools/mk-mesa.sh
/tools/mesa-stamp.sh
/tools/mk-jb.sh
/tools/jb-preinstall.py
/tools/metallib.py

/xnuloader/*
!/xnuloader/build.sh
!/xnuloader/efi.h
!/xnuloader/identity.h
!/xnuloader/identity_v57.h
!/xnuloader/loader.c
!/xnuloader/loader_*.inc
!/xnuloader/platform_private.h
!/xnuloader/slot_choice.h
!/xnuloader/loader_spmi_reboot_private.h
!/xnuloader/ui_font_private.h
!/xnuloader/mkidentity.py
!/xnuloader/mkpayload.py
!/xnuloader/mkstandalone.py
!/xnuloader/test_boot_safety.py

/qemu/*
!/qemu/*.sh
!/qemu/*.py

# of xnu-deps only what is ours; setup.sh fetches and builds the rest
/xnu-deps/*
!/xnu-deps/setup.sh
!/xnu-deps/gen-iig-stubs.py
!/xnu-deps/hostinc/
!/xnu-deps/iig-impl/
!/xnu-deps/host/
/xnu-deps/host/*
!/xnu-deps/host/bin/
/xnu-deps/host/bin/*
!/xnu-deps/host/bin/codesign
!/xnu-deps/host/bin/iig
!/xnu-deps/host/bin/install
!/xnu-deps/host/bin/plutil
!/xnu-deps/host/bin/sw_vers
!/xnu-deps/host/bin/xcrun
!/xnu-deps/host/bin/xnu-clang
!/xnu-deps/build/
/xnu-deps/build/*
!/xnu-deps/build/pthread/
/xnu-deps/build/pthread/*
!/xnu-deps/build/pthread/build.sh
!/xnu-deps/build/pthread/inc/
!/xnu-deps/build/lzbitmap/
/xnu-deps/build/lzbitmap/*
!/xnu-deps/build/lzbitmap/unzbm.c
!/xnu-deps/build/lzbitmap/libzbitmap.c
!/xnu-deps/build/lzbitmap/libzbitmap.h
/tools/android/f2fs-resize
/tools/android/blkpg-tool

# Local diagnostics remain outside source control.
/docs/progress/evidence/
/docs/analysis/local/
